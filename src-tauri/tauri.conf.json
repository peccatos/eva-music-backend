{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVA Player",
  "version": "0.1.0",
  "identifier": "com.eva.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173/?platform=tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EVA Player",
        "width": 480,
        "height": 960,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "resources": [
      "../music/*"
    ]
  }
}
